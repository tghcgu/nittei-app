# Hashed Next.js chunks never change, so browsers can keep them instead of revalidating each visit.
# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Static files (scripts, styles, images) are served without the Worker, so next.config.ts headers do not reach them.
/*
  X-Content-Type-Options: nosniff
