# Headers for the files Cloudflare serves without the Worker (every page except events, which
# custom-worker.mjs sends with the same headers). https://developers.cloudflare.com/workers/static-assets/headers

# Hashed Next.js chunks never change, so browsers can keep them instead of revalidating each visit.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# No other site may show these pages inside a frame (so nobody can trick a visitor into clicking them),
# other sites only learn the domain, never which event was open, and the site uses no camera,
# microphone or location.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000
