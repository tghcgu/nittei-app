{
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/",
      "destination": "https://nitei.pages.dev/",
      "statusCode": 301
    },
    {
      "source": "/:path((?!robots\\.txt$|favicon\\.ico$|icon\\.png$).*)",
      "destination": "https://nitei.pages.dev/:path*",
      "statusCode": 301
    }
  ]
}
